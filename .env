# ═══════════════════════════════════════════════════════════
# Prediction Market Paper Trader — Configuration
# Supports Kalshi + Polymarket in a single process.
# ═══════════════════════════════════════════════════════════

# ── Platform toggles ─────────────────────────────────────
KALSHI_ENABLED=true
POLYMARKET_ENABLED=true

# ── Kalshi API credentials ───────────────────────────────
# Generate at https://kalshi.com/account/profile → API Keys
KALSHI_API_KEY_ID=3d990df3-74d7-47bf-a595-4fae3f4a3a55
KALSHI_KEY_FILE=./.kalshi.key

# API base URL
# Production: https://api.elections.kalshi.com/trade-api/v2
# Demo:       https://demo-api.kalshi.co/trade-api/v2
KALSHI_API_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# ── Polymarket API (public — no auth for reads) ─────────
# Override only if Polymarket changes their URLs.
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_TRADES_LIMIT=200

# ── Polling ──────────────────────────────────────────────
KALSHI_POLL_INTERVAL=60
KALSHI_TRADES_LOOKBACK=300

# ── Anomaly thresholds ───────────────────────────────────
# Calibrated against the $553K "US striking Iran" trade
# placed 1 hour before resolution.
KALSHI_LARGE_ORDER_USD=10000
KALSHI_MEGA_ORDER_USD=1000000
KALSHI_DEADLINE_MINUTES=60
KALSHI_PRICE_MOVE_PCT=15.0
KALSHI_VOLUME_SPIKE_X=5.0
KALSHI_TRIGGER_THRESHOLD=0.35

# ── Paper trading ────────────────────────────────────────
KALSHI_MIRROR_FRACTION=0.01
KALSHI_MAX_POSITION_USD=100
KALSHI_MIN_POSITION_USD=1

# ── Live Scanner ─────────────────────────────────────────
# Minimum total market volume to consider (contracts for Kalshi, USD for Poly)
MIN_MARKET_VOLUME_USD=100000
# Poll interval in seconds (how often to check for new trades)
SCANNER_POLL_INTERVAL=60

# ── Database ─────────────────────────────────────────────
KALSHI_DB_PATH=./kalshi_trader.db
